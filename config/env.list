# driftpilot:sdk-final2b 的镜像 ENV（与 docker inspect .Config.Env 对齐）
#
# 下列 12 项由本项目的 Dockerfile 显式设置；另 5 项（PATH / LANG / GPG_KEY /
# PYTHON_VERSION / PYTHON_SHA256）由基础镜像 python:3.12-alpine 提供。
#
# 说明：SDK 评分路径（harness.py -> contest_harness -> contest_submission.py）
# 不读取 DP_* 变量；这些变量是旧版 legacy 入口的兼容开关，保留是为了与已交付镜像
# 的 config 完全一致。真正影响评分的只有 PYTHONPATH=/app 与线程数上限。

PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
BASELINE_CPU_THREADS=1
PYTHONPATH=/app

# --- 旧版 legacy 入口的兼容开关（SDK 路径不读）---
DP_A_BATCH_WEIGHT=2
DP_LABEL_BUDGET_ENFORCE=1
DP_LABEL_BUDGET_TOTAL=9628
DP_LABEL_DOSE=drop_last
DP_C_SHADOW_MAX_TOTAL=1000

# --- 平台/本地运行时可选项（镜像未设置，按需注入）---
# CONTEST_WORK=/workspace              候选与 state 的临时目录（默认 /workspace）
# CONTEST_ARTIFACT_PATH=/model/...     平台预测时指向选中 checkpoint（由宿主注入）
# CONTEST_SEED=1                       训练 seed 起点（默认 1）
# CONTEST_EPOCHS / CONTEST_LR          A 任务显式覆盖轮内 epoch / 学习率
# CONTEST_WARM_EPOCHS / CONTEST_WARM_LR  父权重已 warm 时的覆盖值
